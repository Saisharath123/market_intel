{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Immutable ECR repositories and least-privilege GitHub Actions image publisher; no cluster deployment credentials.",
  "Parameters": {
    "ExistingGitHubProviderArn": {
      "Type": "String",
      "Default": ""
    }
  },
  "Conditions": {
    "CreateProvider": {
      "Fn::Equals": [
        {
          "Ref": "ExistingGitHubProviderArn"
        },
        ""
      ]
    }
  },
  "Resources": {
    "GitHubProvider": {
      "Type": "AWS::IAM::OIDCProvider",
      "Condition": "CreateProvider",
      "Properties": {
        "Url": "https://token.actions.githubusercontent.com",
        "ClientIdList": [
          "sts.amazonaws.com"
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "market-intel"
          }
        ]
      }
    },
    "DashboardRepository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": "market-intel/dashboard",
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "market-intel"
          }
        ],
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\": [{\"rulePriority\": 1, \"description\": \"Remove untagged build layers after seven days; preserve all tagged releases\", \"selection\": {\"tagStatus\": \"untagged\", \"countType\": \"sinceImagePushed\", \"countUnit\": \"days\", \"countNumber\": 7}, \"action\": {\"type\": \"expire\"}}]}"
        }
      }
    },
    "MarketRepository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": "market-intel/market",
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "market-intel"
          }
        ],
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\": [{\"rulePriority\": 1, \"description\": \"Remove untagged build layers after seven days; preserve all tagged releases\", \"selection\": {\"tagStatus\": \"untagged\", \"countType\": \"sinceImagePushed\", \"countUnit\": \"days\", \"countNumber\": 7}, \"action\": {\"type\": \"expire\"}}]}"
        }
      }
    },
    "NewsRepository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": "market-intel/news",
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "market-intel"
          }
        ],
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\": [{\"rulePriority\": 1, \"description\": \"Remove untagged build layers after seven days; preserve all tagged releases\", \"selection\": {\"tagStatus\": \"untagged\", \"countType\": \"sinceImagePushed\", \"countUnit\": \"days\", \"countNumber\": 7}, \"action\": {\"type\": \"expire\"}}]}"
        }
      }
    },
    "ImagePublisher": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "market-intel-github-publisher",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::If": [
                    "CreateProvider",
                    {
                      "Ref": "GitHubProvider"
                    },
                    {
                      "Ref": "ExistingGitHubProviderArn"
                    }
                  ]
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:Saisharath123@168315578/market_intel@1427747568:ref:refs/heads/main"
                }
              }
            }
          ]
        },
        "MaxSessionDuration": 3600,
        "Tags": [
          {
            "Key": "Project",
            "Value": "market-intel"
          }
        ],
        "Policies": [
          {
            "PolicyName": "PublishProjectImagesOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:InitiateLayerUpload",
                    "ecr:UploadLayerPart",
                    "ecr:CompleteLayerUpload",
                    "ecr:PutImage",
                    "ecr:DescribeImages",
                    "ecr:BatchGetImage",
                    "ecr:DescribeImageScanFindings",
                    "ecr:GetDownloadUrlForLayer"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "DashboardRepository",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "MarketRepository",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "NewsRepository",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "signer:SignPayload",
                  "Resource": {"Fn::Sub": "arn:\u0024{AWS::Partition}:signer:\u0024{AWS::Region}:\u0024{AWS::AccountId}:/signing-profiles/MarketIntelReleaseSigning"}
                },
                {
                  "Effect": "Allow",
                  "Action": "signer:GetRevocationStatus",
                  "Resource": [
                    {"Fn::Sub": "arn:\u0024{AWS::Partition}:signer:\u0024{AWS::Region}:\u0024{AWS::AccountId}:/signing-profiles/MarketIntelReleaseSigning"},
                    {"Fn::Sub": "arn:\u0024{AWS::Partition}:signer:\u0024{AWS::Region}:\u0024{AWS::AccountId}:/signing-jobs/*"}
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "ImagePublisherRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "ImagePublisher",
          "Arn"
        ]
      }
    }
  }
}
